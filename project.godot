; Track Playground — native Godot 4 project
config_version=5

[application]
config/name="轨道工坊 · Track Playground"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1100
window/size/viewport_height=700
window/size/window_width_override=1600
window/size/window_height_override=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/resizable=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.07, 0.10, 0.13, 1)

[physics]
common/physics_ticks_per_second=60

[gui]
theme/default_font_multichannel_signed_distance_field=true

[editor_plugins]
enabled=PackedStringArray("res://addons/runtime_sources/plugin.cfg")
